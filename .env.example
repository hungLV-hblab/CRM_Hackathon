# Copy to `.env` and fill in. NEVER commit `.env` (CLAUDE.md section 6).

# --- Postgres ---------------------------------------------------------------
# Three roles, three jobs -- ADR-0010. None of them is a superuser.
#   crm_owner  : migrations and seed ONLY. The app never connects as this role
#                (a table owner bypasses column privileges -- measured, ADR-0010 #3).
#   crm_app    : the API serving Sales/Admin. Full rights.
#   crm_system : the worker and the AI branches. Only the few columns granted by hand.
POSTGRES_DB=crm
# Superuser password, used by the container only. The app never uses it.
POSTGRES_PASSWORD=change_this_password
# Shared password for the three crm_* roles. Change it here and in the six URLs below.
CRM_DB_PASSWORD=change_this_password

DATABASE_URL_OWNER=postgres://crm_owner:change_this_password@localhost:5403/crm
DATABASE_URL_APP=postgres://crm_app:change_this_password@localhost:5403/crm
DATABASE_URL_SYSTEM=postgres://crm_system:change_this_password@localhost:5403/crm

# A separate test database on the same cluster. Three URLs, because the column-privilege
# tests must connect AS THE RIGHT ROLE to measure anything -- sharing one URL would throw
# away the very thing being proven.
DATABASE_URL_TEST=postgres://crm_owner:change_this_password@localhost:5403/crm_test
DATABASE_URL_TEST_APP=postgres://crm_app:change_this_password@localhost:5403/crm_test
DATABASE_URL_TEST_SYSTEM=postgres://crm_system:change_this_password@localhost:5403/crm_test

# --- Application ------------------------------------------------------------
# api | worker -- one image, two bootstrap branches (ADR-0011).
APP_ROLE=api
API_PORT=3001
# Leave EMPTY in the example file. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- AI parameters ----------------------------------------------------------
# WARNING (ontology 3.4 + ADR-0011): the two variables below are INITIAL VALUES only, read
# exactly ONCE at seed time to populate the `system_settings` table. After that they mean
# nothing -- the effective value lives in the database. Editing .env and expecting the cycle
# to change is a misreading:
#   UPDATE system_settings SET value='10' WHERE key='watch_cycle_seconds';
AI_ENABLED=true
WATCH_CYCLE_SECONDS=60

# Feature group 2 reads this at boot. LEAVE IT EMPTY and the API logs a warning and falls back
# to FixtureClaimExtractor — deterministic, no network, and the whole T-1..T-10 suite still
# runs (ADR-0014 rollback). Fill it in to extract findings with a real LLM.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5 when empty.
ANTHROPIC_MODEL=
